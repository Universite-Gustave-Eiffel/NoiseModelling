@misc{tagusari_dynamic_2023,
	title = {Dynamic {Generation} of {Noise} {Maps}: {Accurate} and {Efficient} {Assessment} of {Noise} {Exposure}},
	url = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4612924},
	doi = {10.2139/ssrn.4612924},
	abstract = {Noise mapping is widely utilized to assess noise exposure and formulate noise mitigation policies.  However, in practice, noise mapping faces several challenges: (1) it may oversimplify the actual settings and use inaccurate geospatial data and/or inappropriate parameters, (2) noise mapping requires expert knowledge and complex computations,  and (3) it is time-consuming.  To address these issues, the author propose an approach for dynamically generating small noise maps with a system designed to predict sound levels.  Instead of presenting static noise maps with fixed geometries and calculation parameters, this approach offers a dynamic noise mapping system.  The author implemented this noise mapping system as a plugin for the "QGIS" software, seamlessly integrating geospatial databases provided by the government and public agencies, along with a sound-level calculation module named "NoiseModelling".   The performance and validity of the system were evaluated by applying it to real cases in Japan.  Noise maps were generated efficiently, and the predicted results closely matched measured data although adjustments to the geospatial inputs were necessary to reflect the actual conditions in some instances.  The system leverages a geospatical database for trunk roads in Japan, providing essential data for predicting sound levels; therefore, its development demonstrates the feasibility of assessing road traffic noise in the vicinity of nearly all trunk roads in Japan.  The dynamic generation of noise maps facilitates the refinement of input data and parameters, thereby enhancing prediction accuracy and enabling noise mapping in diverse scenarios.  The proposed approach holds promise for practical noise map applications, fostering collaboration between experts and non-specialits through the creation of noise maps.},
	author = {Tagusari, Junta},
	year = {2023},
	keywords = {Noise exposure, GIS, Interface, HRISK, ✅ Check},
}

@inproceedings{legriffon_drone_2024,
	address = {Nantes, France},
	title = {Drone fleet noise impact calculation - a methodology},
	url = {https://hal.science/hal-04711864v1/},
	doi = {10.3397/IN_2024_3049},
	abstract = {The introduction of drones into an already dense urban infrastructure is expected to have an important impact on the population. The goal of the SESAR MUSE project, " Measuring U-Space Social and Environmental Impact ", is to develop a set of key performance indicators, methods
and tools for the comprehensive and rigorous assessment of the impact of UAM operations on the liveability and quality of life in European cities. One focus domain is drone-generated noise. In the frame of this project, a number of ONERA tools is chained in order to create noise maps, from scratch, for realistic drone fleet scenarios. Hence, in this paper a methodology is presented where a flight mechanics tool, noise source models, an en-route tool and an open-source urban noise propagation tool are chained, allowing complete freedom with regard to choice and number of drones, concept of operations and type of urban environment.},
	booktitle = {{INTER}-{NOISE} and {NOISE}-{CON} {Congress} and {Conference} {Proceedings}},
	author = {Legriffon, Ingrid and Ruaud, Elise},
	year = {2024},
	keywords = {e-VTOL, ✅ Check},
	pages = {1675--1680},
}

@article{soto-molina_enhancing_2025,
	title = {Enhancing noise assessment accuracy: {FEM} as an advanced complement to {CNOSSOS}-{EU}},
	url = {https://journals.sagepub.com/doi/10.1177/09574565251319271},
	doi = {10.1177/09574565251319271},
	abstract = {This study explores the enhancement of noise assessment accuracy by integrating the Finite Element Method (FEM) as a complementary approach to the Common Noise Assessment Methods in Europe (CNOSSOS-EU). CNOSSOS-EU, widely adopted as the reference for strategic noise mapping across Europe and beyond, provides an semi-empirical model for noise propagation based on experimental algorithms and simplifications. While robust, CNOSSOS-EU’s approach can overlook the complex physical and geometric characteristics of certain environments, particularly in detailed or high-stakes noise assessments. To address these limitations, this work demonstrates how FEM—rooted in fundamental physical principles—can serve as a powerful adjunct to CNOSSOS-EU, offering finer detail in modeling noise propagation in complex environments. By comparing and validating FEM-derived results against those of CNOSSOS-EU, this study identifies key discrepancies and analyzes their implications for noise management strategies. The findings underscore the added value of integrating FEM, ultimately supporting more informed decision-making and the development of effective noise control measures.},
	journal = {Noise \& Vibration Worldwide},
	author = {Soto-Molina, Ignacio and Prieto, Miguel Ausejo and Ruiz, Rosa Maria Arce},
	year = {2025},
	keywords = {END, ✅ Check},
}

