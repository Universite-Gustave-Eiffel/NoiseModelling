@article{galassi_luquezi_current_2024,
	title = {Current limitations and opportunities for improvements of agent-based transport models for noise exposure assessment},
	volume = {368},
	issn = {0301-4797},
	url = {https://www.sciencedirect.com/science/article/pii/S0301479724021157},
	doi = {10.1016/j.jenvman.2024.122129},
	abstract = {Agent-based models represent a promising approach for simulating transport systems and assessing their environmental noise impact, potentially enhancing standard noise exposure assessments. However, it is very important to understand the relevance of these assessments within the context of models initially designed for transport studies. Then, this research investigates the utilization of agent-based transport models when coupled with environmental models to assess individual exposure to transport-related noise. This is achieved by proposing a method to evaluate this approach across four dimensions: spatial, temporal, individual, and activity patterns. This evaluation is demonstrated and discussed with an exemplification model applied in the Lyon Metropolitan Area using open-source tools (MATSim, EQASim, NoiseModelling), which is a representative framework of the current literature. The findings encompass a range of issues, including the conceptualization of exposure contexts and activity spaces, the resolution of the acoustic content, the disaggregation of data at the individual level, the variability in noise reactions, and the correlation structures between social and exposure profiles. The study contributes to the advancement of exposure assessment with insights for future improvements in the field. Further, it underscores the need for more quantitative analyses and scientific research into momentary noise exposure and social epidemiology.},
	urldate = {2025-06-10},
	journal = {Journal of Environmental Management},
	author = {Galassi Luquezi, Leonardo and Le Bescond, Valentin and Aumond, Pierre and Gastineau, Pascal and Can, Arnaud},
	month = sep,
	year = {2024},
	keywords = {Activity-based transport models, Agent-based transport models, Environmental assessment, Noise exposure assessment, Noise modeling, Urban environment, UMRAE, Traffic dynamics, ✅ Check},
	pages = {122129},
	file = {ScienceDirect Full Text PDF:/home/gpetit/snap/zotero-snap/common/Zotero/storage/ISDEVKSG/Galassi Luquezi et al. - 2024 - Current limitations and opportunities for improvements of agent-based transport models for noise exp.pdf:application/pdf;ScienceDirect Snapshot:/home/gpetit/snap/zotero-snap/common/Zotero/storage/HMHMLPNI/S0301479724021157.html:text/html},
}

@article{indacoechea-vega_life_2024,
	title = {Life cycle approach for evaluating the environmental and economic viability of low-noise asphalt pavements},
	volume = {466},
	issn = {0959-6526},
	url = {https://www.sciencedirect.com/science/article/pii/S0959652624022339},
	doi = {10.1016/j.jclepro.2024.142785},
	abstract = {This paper aims to make recommendations about the convenience of using low-noise pavements to mitigate traffic noise under different traffic and population scenarios. To do so, a life cycle approach has been applied by performing a Life-cycle Assessment (LCA) and Life-cycle Cost Analysis (LCCA). To account for the noise mitigation achieved by the road surfaces, which is the main benefit compared to conventional road surfaces, the damage effect of traffic noise has been incorporated in both analyses. Thus, open source noise emission and propagation modelling and Geographical Information System (GIS) tools have been used to determine the noise level at which residents are exposed. The impact of noise emissions on human health is estimated and expressed in disability-adjusted life years (DALYs) and the related external cost have been calculated by monetarizing the environmental impacts and by integrating them within the cost assessment. The methodology followed allowed the comparison of different scenarios and the results show a huge potential for reducing environmental impacts and costs when using low-noise road surfaces although accurate information about the acoustic aging of the materials is key in order to ensure that benefits are obtained.},
	urldate = {2025-06-10},
	journal = {Journal of Cleaner Production},
	author = {Indacoechea-Vega, Irune and Miera-Dominguez, Helena and Lastra-González, Pedro and Castro-Fresno, Daniel},
	month = aug,
	year = {2024},
	keywords = {END, ✅ Check, DALY, Environmental prices, Life cycle assessment, Life cycle cost analysis, Low-noise asphalt pavement, Noise impact},
	pages = {142785},
	file = {ScienceDirect Snapshot:/home/gpetit/snap/zotero-snap/common/Zotero/storage/33DBI2GX/S0959652624022339.html:text/html},
}

@article{baclet_strategic_2022,
	title = {From strategic noise maps to receiver-centric noise exposure sensitivity mapping},
	volume = {102},
	issn = {1361-9209},
	url = {https://www.sciencedirect.com/science/article/pii/S1361920921004089},
	doi = {10.1016/j.trd.2021.103114},
	abstract = {Road traffic is a major source of environmental noise pollution in urban areas. While strategic noise maps are widely used to identify the critical areas and propose mitigation plans, more specific tools are needed to evaluate the impact from traffic noise such as overall population exposure or anticipated impact from specific vehicles in varying spatiotemporal traffic conditions. The present contribution proposes a receiver-centric mapping approach, introducing “noise-exposure sensitivity maps”, meant to assess the potential noise exposure impact from a specific vehicle in a given network, quantifying the associated exceedance over the prevailing background noise, under varying spatiotemporal traffic conditions. The resulting maps are thus focussed on a representation of the receiver exposure as opposed to considering the noise emission and propagation alone. The complete methodology, its underlying assumptions, and possible applications such as route optimisation are demonstrated on realistic scenarios.},
	urldate = {2025-06-10},
	journal = {Transportation Research Part D: Transport and Environment},
	author = {Baclet, Sacha and Venkataraman, Siddharth and Rumpler, Romain and Billsjö, Robin and Horvath, Johannes and Österlund, Per Erik},
	month = jan,
	year = {2022},
	keywords = {Noise mapping, Road traffic noise, END, Traffic dynamics, Population exposure, ✅ Check, Road network sensitivity},
	pages = {103114},
	file = {ScienceDirect Snapshot:/home/gpetit/snap/zotero-snap/common/Zotero/storage/54GPAFUZ/S1361920921004089.html:text/html;Texte intégral:/home/gpetit/snap/zotero-snap/common/Zotero/storage/XCC68VWB/Baclet et al. - 2022 - From strategic noise maps to receiver-centric noise exposure sensitivity mapping.pdf:application/pdf},
}

@inproceedings{maristany_mapa_2023,
	address = {Argentina},
	title = {Mapa de ruido de la ciudad de {Córdoba}. {Promeros} resultados mediante el uso de software de codigo abierto},
	abstract = {El ruido es uno de los mayores contaminantes ambientales. Genera un importante impacto urbano, paisajístico y arquitectónico en las grandes ciudades, presentando una directa incidencia en el confort de vida de los habitantes. En la actualidad, la evaluación del ruido ambiental se está llevando a cabo a través de técnicas de simulación de los niveles sonoros. Estas técnicas de cálculo han sido normalizadas y validadas, siendo reconocidas internacionalmente. Se ha iniciado la confección del Mapa de Ruido de la ciudad de Córdoba a los efectos de realizar un diagnóstico de la situación acústica actual. La herramienta utilizada es el software OrbisGIS y su complemento NoiseModelling. El software Noisemodelling es una herramienta gratuita y de código abierto que permite producir mapas de ruido en áreas urbanas, utilizando una base de datos espacial y una interfaz web amigable. Se muestran los primeros resultados y su validación mediante mediciones. Los estudios se iniciaron en el distrito 4 de la ciudad, que abarca el área central y barrios aledaños. Se concluye que las simulaciones son eficientes, generando resultados muy similares a las mediciones, y acordes a la información de entrada, lo cual permite validar y confirmar la potencialidad de uso de esta herramienta.},
	booktitle = {{XVIII} {Congreso} {Argentino} de {Acústica} 2023 ({AdAA2023})},
	author = {Maristany, Arturo and {L.Abadía} and {D.Moyano} and {A.Pacharoni} and {M.Durán} and {S.Coca} and {B.Yelicich}},
	month = jan,
	year = {2023},
	keywords = {END, ✅ Check},
	file = {Full Text PDF:/home/gpetit/snap/zotero-snap/common/Zotero/storage/XN7PGSXL/Maristany et al. - 2023 - Mapa de ruido de la ciudad de Córdoba. Promeros resultados mediante el uso de software de codigo abi.pdf:application/pdf},
}

@article{nourmohammadi_mapping_2021,
	title = {Mapping {Urban} {Environmental} {Performance} with {Emerging} {Data} {Sources}: {A} {Case} of {Urban} {Greenery} and {Traffic} {Noise} in {Sydney}, {Australia}},
	volume = {13},
